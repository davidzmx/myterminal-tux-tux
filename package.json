{
  "name": "myterminal-tux-tux",
  "version": "1.0.0",
  "description": "Multiplatform terminal emulator with Terminator-style splits, tabs, Git integration, SSH profiles and session persistence",
  "main": "src/main/main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:linux:portable": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win portable nsis",
    "dist:win:portable": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:all": "electron-builder -mwl"
  },
  "keywords": [
    "terminal",
    "terminator",
    "git",
    "ssh",
    "splits",
    "xterm",
    "electron"
  ],
  "author": "MyTerminal Tux Tux Team",
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.2"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tuxtux.myterminal",
    "productName": "MyTerminal Tux Tux",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "TerminalEmulator",
      "synopsis": "Modern terminal emulator with splits, tabs, SSH and Git integration",
      "description": "Terminal emulator with Terminator-style splits, tabs, SSH profile manager, interactive Git buttons, and cross-platform session persistence."
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyTerminal Tux Tux"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    }
  }
}
